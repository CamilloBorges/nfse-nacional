{
  "name": "directus-extension-nfse-nacional",
  "version": "0.1.0",
  "description": "Busca automática das NFS-e do Ambiente de Dados Nacional (ADN) para coleções do Directus, com o certificado A1 cifrado em repouso",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "nfse",
    "nfse-nacional",
    "adn"
  ],
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "nfse-nacional-agenda",
        "source": "src/hook/index.ts"
      },
      {
        "type": "endpoint",
        "name": "nfse-nacional",
        "source": "src/endpoint/index.ts"
      },
      {
        "type": "module",
        "name": "nfse-nacional-tela",
        "source": "src/module/index.ts"
      }
    ],
    "host": "^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nfse-nacional-core": "^0.1.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.0"
  }
}
